{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Aux",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm install && npm run dev -- --port 5173 --strictPort --open",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Run Aux (Chrome, with debugger)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173/",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "Aux: start"
    }
  ]
}
