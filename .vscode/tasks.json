{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Aux: install",
      "type": "shell",
      "command": "npm install",
      "presentation": { "reveal": "silent", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Aux: start",
      "type": "shell",
      "command": "npm run dev -- --port 5173 --strictPort",
      "dependsOn": "Aux: install",
      "isBackground": true,
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^__never__$" },
        "background": { "activeOnStart": true, "beginsPattern": "vite", "endsPattern": "Local:" }
      }
    }
  ]
}
