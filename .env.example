# Public values for the app normally live in .env.development (committed). Copy this file to .env only to
# override them on one computer; .env is never committed.

# Spotify: paste your app's Client ID (Spotify Developer Dashboard -> your app -> Settings).
# Leave empty to use sample listening data. The Client ID is not a secret; never put a Client Secret here.
# Redirect URI to register in the dashboard: http://127.0.0.1:5173/
VITE_SPOTIFY_CLIENT_ID=

# Supabase backend: Project Settings -> API Keys. Both values are public by design (the database's
# security rules protect the data). Leave empty to run on sample data. Never put the service_role/secret key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Last.fm (live mode): API key from https://www.last.fm/api/account/create. Public by design.
# The shared secret goes only into Supabase (Edge Functions -> Secrets), never here.
VITE_LASTFM_API_KEY=
