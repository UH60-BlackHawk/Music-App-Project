# Public settings used when the app runs on your computer (npm run dev / F5 in VS Code).
# Committed on purpose: every value here is public by design and ends up inside the app anyway.
# NEVER put secrets here (Spotify client secret, Last.fm shared secret, Supabase service_role key or
# database password). Those go only into Supabase: Edge Functions -> Secrets.
# A private .env or .env.local file, if you make one, overrides these and is never committed.

# Spotify app (developer.spotify.com/dashboard). Redirect URI registered there: http://127.0.0.1:5173/
VITE_SPOTIFY_CLIENT_ID=194dfd6ca1f440899ad72929dbf6ecbf
